Set Shell "FISH_PROMPT=min /usr/bin/fish -PC 'cd ~/'"
Set FontSize 24
Set Width 850
Set Height 500
Set Theme "Gruvbox Dark"
Set Padding 10
Set TypingSpeed 150ms

Type "too" Sleep 500ms Tab
Sleep 1s
Type "ls" Sleep 500ms Enter
Sleep 1s
Type "too" Sleep 500ms Tab
Sleep 1s
Type "rm" Sleep 500ms Tab Tab Enter
Sleep 1s
Type "y" Enter
Sleep 1s
Type "too" Sleep 500ms Tab
Sleep 1s
Type "rm" Sleep 500ms Tab Type "-" Sleep 200ms Tab Sleep 200ms Tab Sleep 200ms Enter Tab Sleep 200ms Enter
Sleep 1s
Type "y" Enter
Sleep 1s
Type "too" Sleep 500ms Tab
Sleep 1s
Type "ls" Sleep 500ms Enter
Sleep 3s
