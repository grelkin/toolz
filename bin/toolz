# :command.usage
toolz_usage() {
  if [[ -n $long_usage ]]; then
    printf "toolz - Shell Script Manager\n"
    echo

  else
    printf "toolz - Shell Script Manager\n"
    echo

  fi

  printf "%s\n" "$(bold "Usage:")"
  printf "  toolz COMMAND\n"
  printf "  toolz [COMMAND] --help | -h\n"
  printf "  toolz --version | -v\n"
  echo
  # :command.usage_commands
  printf "%s\n" "$(bold "Commands:")"
  printf "  %s   Runs toolz command (default)\n" "$(green_bold "run")   "
  printf "  %s   Lists all toolz commands and/or libraries\n" "$(green_bold "list")  "
  printf "  %s   Opens command or library in \$EDITOR, creates new if it doesn't exist\n" "$(green_bold "edit")  "
  printf "  %s   Removes command or library\n" "$(green_bold "remove")"
  printf "  %s   Spawns a shell in your \$TOOLZ_DIR directory\n" "$(green_bold "cd")    "
  printf "  %s   Displays path to the library\n" "$(green_bold "src")   "
  printf "  %s   Configures the shell environment\n" "$(green_bold "init")  "
  echo

  # :command.long_usage
  if [[ -n $long_usage ]]; then
    printf "%s\n" "$(bold "Options:")"

    # :command.usage_fixed_flags
    printf "  %s\n" "$(yellow "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(yellow "--version, -v")"
    printf "    Show version number\n"
    echo

    # :command.usage_environment_variables
    printf "%s\n" "$(bold "Environment Variables:")"

    # :environment_variable.usage
    printf "  %s\n" "$(blue_bold "TOOLZ_DIR (required)")"
    printf "    Directory with your commands and libraries\n"
    printf "    Default: $HOME/.toolz\n"
    echo

    # :environment_variable.usage
    printf "  %s\n" "$(blue_bold "TOOLZ_PREFIX (required)")"
    printf "    Prefix for your commands\n"
    printf "    Default: toolz-\n"
    echo

    # :environment_variable.usage
    printf "  %s\n" "$(blue_bold "TOOLZ_SUFFIX (required)")"
    printf "    Suffix for your commands and libraries\n"
    printf "    Default: .sh\n"
    echo

  fi
}

